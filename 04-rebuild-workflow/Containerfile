# Red Hat UBI 9 base image — rootless by default and supported for OpenShift (OCP).
# Tip for OCP production: pin a specific version tag or @sha256 digest.
FROM registry.access.redhat.com/ubi9/nodejs-20:latest

LABEL io.k8s.display-name="UBI 9 Rebuild Demo" \
      io.openshift.expose-services="3000:http"

# Build-time argument (never pass secrets via ARG — use OCP Secrets at runtime).
ARG APP_VERSION=1.0.0

WORKDIR /opt/app-root/src

# Copy dependency manifest before source to maximize Podman / OCP BuildConfig cache hits.
# --chown=1001:0 ensures group 0 (root group) ownership for OCP restricted-v2 arbitrary UIDs.
COPY --chown=1001:0 package.json ./
COPY --chown=1001:0 src/ ./src/

# Stamp immutable build metadata into the image and align GID 0 permissions (g=u) for OCP.
RUN printf '{"appVersion":"%s","builtAt":"%s"}\n' "$APP_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /opt/app-root/src/build-info.json \
    && chmod -R g=u /opt/app-root/src

# Unprivileged port (>= 1024 required under OCP restricted-v2 SCC).
EXPOSE 3000

# Explicit numeric non-root UID required by Kubernetes/OCP runAsNonRoot: true.
USER 1001

# Exec-form CMD so Node.js runs as PID 1 and handles SIGTERM gracefully in OCP.
CMD ["node", "src/server.js"]
