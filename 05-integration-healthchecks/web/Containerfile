# Red Hat UBI 9 NGINX 1.24 — rootless web/proxy image compliant with OpenShift restricted-v2 SCC.
FROM registry.access.redhat.com/ubi9/nginx-124:latest

LABEL io.k8s.display-name="UBI 9 Integration Web Gateway" \
      io.openshift.expose-services="8080:http"

# Bake static page and proxy config with GID 0 ownership for OCP arbitrary-UID pods.
COPY --chown=1001:0 index.html /opt/app-root/src/index.html
COPY --chown=1001:0 app.conf /opt/app-root/etc/nginx.default.d/app.conf
RUN chmod -R g=u /opt/app-root/src /opt/app-root/etc/nginx.default.d

# Unprivileged port 8080 (>= 1024 required under OCP restricted-v2; NET_BIND_SERVICE dropped).
EXPOSE 8080

# Explicit numeric non-root UID satisfies OCP runAsNonRoot admission policy.
USER 1001

# Override S2I usage script with foreground NGINX in exec form for clean OCP SIGTERM handling.
CMD ["nginx", "-g", "daemon off;"]
