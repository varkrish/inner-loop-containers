# Red Hat UBI 9 Node.js 20 — rootless base image compliant with OpenShift restricted-v2 SCC.
FROM registry.access.redhat.com/ubi9/nodejs-20:latest

LABEL io.k8s.display-name="UBI 9 Integration API Service" \
      io.openshift.expose-services="3000:http"

WORKDIR /opt/app-root/src

# Assign GID 0 (--chown=1001:0) and group=user permissions for OCP arbitrary-UID pods.
COPY --chown=1001:0 server.js /opt/app-root/src/server.js
RUN chmod -R g=u /opt/app-root/src

# Unprivileged port (>= 1024); expose /healthz for both Compose healthcheck and OCP probes.
EXPOSE 3000

# Numeric non-root UID satisfies OCP runAsNonRoot admission policy.
USER 1001

# Exec-form CMD ensures clean SIGTERM delivery during OCP rolling updates.
CMD ["node", "server.js"]
